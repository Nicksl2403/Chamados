{
  "rewrites": [
    {
      "source": "/api/chamados",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/api/chamados/(.*)",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/api",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}